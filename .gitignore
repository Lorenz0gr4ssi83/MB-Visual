# pacchetto portatile (oltre il limite di GitHub): si ricrea con tools/build_portable.py
MB Visual - portatile.zip
*.zip
# librerie dell'app per PC: si riscaricano con tools/fetch_vendor.py (la web app in docs/ ha le sue)
ui/vendor/
# file prodotti dai collaudi
tests/out_*
__pycache__/
*.pyc
*.mbv-tmp

# copia pronta all'uso dell'app per PC (si ricrea con tools/build_portable.py)
App per PC/
# campioni ricavati da un DWG reale (tools/make_damaged_samples.py --dwg): non vanno nel repository
tests/samples/danneggiati/disegno_troncato*
!tests/samples/danneggiati/archivio_troncato.zip

# ID dei client OAuth scritti dalle build (tools/cloud_secrets.py)
mbvisual/cloud_ids_build.py

# app Android: dipendenze e file generati da "npx cap sync"
android-app/node_modules/
android-app/android/app/src/main/assets/public/
android-app/android/app/src/main/assets/capacitor.config.json
android-app/android/app/src/main/assets/capacitor.plugins.json
android-app/android/capacitor-cordova-android-plugins/
